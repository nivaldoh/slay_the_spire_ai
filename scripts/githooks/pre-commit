#!/usr/bin/env python3
"""git pre-commit hook: refuse a commit until scripts/check.py has passed on exactly the files
now in this tree (its record, runs/checks/last-pass.json, holds tree_content's hash). git runs it
for every `git commit`, however the command is spelled; `--no-verify` skips it. Enable it once per
clone with `git config core.hooksPath scripts/githooks` (the owner's choice, not yet made)."""
import importlib.util
import json
import subprocess
import sys
from pathlib import Path

ROOT = Path(subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True,
                           text=True, check=True).stdout.strip())


def checked(root: Path = ROOT) -> bool:
    try:
        record = json.loads((root / "runs/checks/last-pass.json").read_text())
        spec = importlib.util.spec_from_file_location("check_script", root / "scripts/check.py")
        check = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(check)
        return record.get("tree") == check.tree_content(root)
    except Exception:  # a broken check.py or record refuses the commit
        return False


if __name__ == "__main__":
    if not checked():
        print("pre-commit: scripts/check.py has not passed on these exact files; run it, read "
              "its result, then commit (AGENTS.md: before each commit)", file=sys.stderr)
        sys.exit(1)
